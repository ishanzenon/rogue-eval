diff --git a/mm_agents/agent_litellm.py b/mm_agents/agent_litellm.py
--- a/mm_agents/agent_litellm.py
+++ b/mm_agents/agent_litellm.py
@@ -605,6 +605,28 @@
         return ""
 
     def _extract_responses_output(self, response: Any) -> tuple[str, str]:
+        if os.environ.get("ROGUE_INSPECT_BRIDGE") == "1":
+            # The Inspect Responses bridge serializes reasoning in a separate
+            # assistant message before the action text. Its opaque reasoning
+            # envelope is not an action and should not end up in evidence logs.
+            text_parts, reasoning_parts = [], []
+            for item in getattr(response, "output", None) or []:
+                item_type = item.get("type") if isinstance(item, dict) else getattr(item, "type", None)
+                if item_type != "message":
+                    continue
+                content = item.get("content", "") if isinstance(item, dict) else getattr(item, "content", "")
+                text = self._extract_content_text(content)
+                think = re.fullmatch(r"<think(?:\s[^>]*)?>(.*?)</think>", text.strip(), re.DOTALL)
+                if think:
+                    summary = re.search(r"<summary>(.*?)</summary>", think[1], re.DOTALL)
+                    if summary:
+                        reasoning_parts.append(summary[1])
+                    elif 'redacted="true"' not in think[0].split(">", 1)[0]:
+                        reasoning_parts.append(think[1].strip())
+                elif text:
+                    text_parts.append(text)
+            if text_parts or reasoning_parts:
+                return "\n".join(text_parts), "\n".join(reasoning_parts)
         message = self._extract_responses_message(response)
         if message is None:
             return getattr(response, "output_text", "") or "", self._extract_responses_reasoning(response)
