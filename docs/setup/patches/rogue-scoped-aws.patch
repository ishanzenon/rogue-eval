new file mode 100644
--- /dev/null
+++ b/desktop_env/providers/aws/scoped_launch.py
@@ -0,0 +1,26 @@
+"""Optional launch template issued by the scoped AWS account operator."""
+
+import json
+import os
+from pathlib import Path
+
+from desktop_env.providers.aws.config import (
+    AWS_SCHEDULER_ROLE_ARN,
+    DEFAULT_TTL_MINUTES,
+    ENABLE_TTL,
+)
+
+
+def scoped_launch_request(region):
+    path = os.environ.get("ROGUE_AWS_LAUNCH_REQUEST")
+    if not path:
+        return None
+    if region != os.environ.get("AWS_REGION"):
+        raise ValueError("Scoped AWS launch region differs from the controller configuration")
+    if not ENABLE_TTL or DEFAULT_TTL_MINUTES < 1 or not AWS_SCHEDULER_ROLE_ARN:
+        raise ValueError("Scoped AWS launch requires a positive TTL and Scheduler execution role")
+    with Path(path).open(encoding="utf-8") as launch_file:
+        request = json.load(launch_file)
+    if request["MinCount"] != 1 or request["MaxCount"] != 1:
+        raise ValueError("Scoped AWS request must provision exactly one desktop")
+    return request
